# Copy this file to .env in the repository root. Never commit .env.
# Never use VITE_ variables for secrets: those are public browser assets.
# Reserved foundation settings. P01 binds fixed loopback ports and persists no audio.
AIC_ENV=development
AIC_HOST=127.0.0.1
AIC_PORT=8000
AIC_RAW_AUDIO_PERSISTENCE=false

# demo uses preset replies. It does not call an external AI service.
AIC_CHAT_MODE=demo

# Optional: set MODE=cloud and all fields below, then restart dev:desktop.
# Supply the complete Chat Completions endpoint (HTTPS), e.g. /chat/completions.
# Your chosen provider may charge for requests. Keys stay in the local backend.
AIC_CHAT_URL=
AIC_CHAT_MODEL=
AIC_CHAT_API_KEY=
