{
  "name": "ai-companion",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev:desktop": "node tools/dev-desktop.mjs",
    "test:desktop": "playwright test",
    "dev:web": "pnpm --filter @ai-companion/web dev",
    "dev:mobile": "pnpm --filter @ai-companion/mobile start",
    "typecheck": "pnpm -r typecheck",
    "build:web": "pnpm --filter @ai-companion/web build",
    "bundle:mobile": "node tools/bundle-mobile.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.0",
    "typescript": "6.0.3"
  }
}
